
@page
@model Affinidi_Login_Demo_App.LoginModel
@{
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h2 class="mb-4">Login</h2>
                    <p class="mb-4">Sign in with your email and password, or use Affinidi Login for secure authentication.</p>
                    <form method="post" asp-page-handler="Login" class="mb-3">
                        <button class="btn btn-primary btn-lg rounded-pill w-100 mb-2" type="submit">
                            <img src="~/Affinidi_FC_RGB_Symbol.jpg" style="padding-right: 6px; max-height: 28px; vertical-align: middle;"> Affinidi Login
                        </button>
                    </form>
                    <hr />
                    <form>
                        <input type="email" class="form-control mb-2" placeholder="Email" />
                        <input type="password" class="form-control mb-3" placeholder="Password" />
                        <button class="btn btn-outline-secondary w-100 rounded-pill" type="submit">Old Way of Login</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>