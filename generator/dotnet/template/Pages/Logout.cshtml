
@page
@model Affinidi_Login_Demo_App.LogoutModel
@{
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    @if (Model.loggedOut)
                    {
                        <h3 class="mb-4">You have been logged out from the application</h3>
                    }
                    <h5>Redirecting you to <a href="/Index">Home page</a> in <span id="countdown">5</span> seconds.</h5>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    var seconds = 5;
    function updateCountdown() {
        document.getElementById("countdown").innerText = seconds;
        if (seconds === 0) {
            window.location.href = "/Index";
        } else {
            seconds--;
            setTimeout(updateCountdown, 1000);
        }
    }
    updateCountdown();
</script>