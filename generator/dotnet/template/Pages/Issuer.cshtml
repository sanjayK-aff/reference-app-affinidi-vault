@page
@model Affinidi_Login_Demo_App.IssuerModel
@{
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="mb-4">Personal Details</h2>
                    @if (!Model.IssuanceFinished)
                    {
                        <form method="post">
                            <div class="mb-3">
                                <label for="givenName" class="form-label">Given Name</label>
                                <input type="text" class="form-control" id="givenName" name="GivenName" value="@Model.GivenName" />
                            </div>
                            <div class="mb-3">
                                <label for="familyName" class="form-label">Family Name</label>
                                <input type="text" class="form-control" id="familyName" name="FamilyName" value="@Model.FamilyName" />
                            </div>
                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="email" class="form-control" id="email" name="Email" value="@Model.Email" />
                            </div>
                            <hr />
                            <h5 class="mb-3">Education Details

                            </h5>
                            <div class="mb-3">
                                <label for="institutionName" class="form-label">Institution Name</label>
                                <input type="text" class="form-control" id="institutionName" name="Education.institutionName" value="@Model.Education?.institutionName " />
                            </div>
                            <div class="mb-3">
                                <label for="dateFrom" class="form-label">Date From</label>
                                <input type="text" class="form-control" id="dateFrom" name="Education.dateFrom" value="@Model.Education?.dateFrom " />
                            </div>
                            <div class="mb-3">
                                <label for="dateTo" class="form-label">Date To</label>
                                <input type="text" class="form-control" id="dateTo" name="Education.dateTo" value="@Model.Education?.dateTo" />
                            </div>
                            <button type="submit" class="btn btn-success w-100 rounded-pill">Start Issuance</button>
                        </form>
                        @if (Model.IssuanceStarted)
                        {
                            <div class="alert alert-info mt-3">Issuance started (dummy method called).</div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-success mt-3">
                            <h4>Issuance Completed!</h4>
                            <h5>Claim your credential!</h5>
                            <div class="mb-3">
                                <p>Scan the QR code below or click the button to claim your credentials.</p>
                                @if (!string.IsNullOrEmpty(Model.issuanceResponse.CredentialOfferUri))
                                {
                                    <!-- QR code image generated from CredentialOfferUri -->
                                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=@Model.claimUrl"alt="QR Code" class="mb-2 d-block mx-auto" />
                                }
                                else
                                {
                                    <div class="text-danger">No QR code available.</div>
                                }
                            </div>
                            <div class="mb-3 text-center">
                                @if (!string.IsNullOrEmpty(Model.CredentialOfferUri))
                                {
                                    <a href="@Model.claimUrl" target="_blank" class="btn btn-primary rounded-pill">Claim Credential</a>
                                }
                            </div>
                            <pre><code>@Model.IssuanceResponseJson</code></pre>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

