@page
@model Affinidi_Login_Demo_App.UserDetailModel
@{
}
<!-- Needed so that POSTs send an anti-forgery token -->
@addTagHelper*, Microsoft.AspNetCore.Mvc.TagHelpers

<style type="text/css">
    button {
        width: 200px;
    }
</style>

<h1>User Logged-in Details</h1>
<div style="padding: 4rem;">

@{
    var username = Model.Username;
    var email = Model.Email;
    var did = Model.DID;
}
    <div class="card mx-auto" style="max-width: 500px;">
        <div class="card-body">
            <h4 class="card-title mb-3">User Details</h4>
            <ul class="list-group list-group-flush text-start">
                <li class="list-group-item"><b>Name:</b> @username</li>
                <li class="list-group-item"><b>Email:</b> @email</li>
                <li class="list-group-item"><b>DID:</b> @did</li>
            </ul>
        </div>
    </div>
</div>
<div style="padding: 2rem; padding-left: 4rem;">
<form method="post">
    @* <p><button value="RefreshToken" asp-page-handler="RefreshToken">Refresh Token</button></p> *@
    @if (!string.IsNullOrEmpty(Model.AccessToken))
    {
        <p><button value="Logout" asp-page-handler="Logout">Clear cookies</button></p>
    }
</form>
</div>
